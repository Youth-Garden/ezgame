datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum GameType {
  CARO
  TICTACTOE
}

model Room {
  id        String     @id @default(uuid())
  code      String     @unique // VD: "CR-9281"
  gameType  GameType   @default(CARO)
  status    RoomStatus @default(WAITING)
  createdAt DateTime   @default(now())
}
